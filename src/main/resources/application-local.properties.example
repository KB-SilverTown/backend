# 이 파일을 application-local.properties로 복사한 뒤 로컬 값을 입력하세요.
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/silvertown?connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
db.username=your_username
db.password=your_password

# Base64로 인코딩한 32바이트 AES 키입니다. 운영 환경에서는 환경변수 ACCOUNT_CRYPTO_KEY로 주입하세요.
account.crypto-key=${ACCOUNT_CRYPTO_KEY:}

# Mock 블랙리스트 테스트 계좌를 "은행코드:계좌번호"의 SHA-256 해시로 등록합니다.
# 실제 계좌번호 원문은 설정 파일이나 저장소에 기록하지 마세요. 여러 해시는 쉼표로 구분합니다.
risk.blacklist.mock.account-hashes=${RISK_BLACKLIST_MOCK_ACCOUNT_HASHES:}

# Base64로 인코딩한 32바이트 JWT HMAC 키입니다. 운영 환경에서는 환경변수 JWT_SECRET으로 주입하세요.
jwt.secret=${JWT_SECRET:}
jwt.access-ttl-seconds=${JWT_ACCESS_TTL_SECONDS:3600}
jwt.refresh-ttl-seconds=${JWT_REFRESH_TTL_SECONDS:1209600}

# 보호자 인증번호 HMAC 키입니다. 운영·데모 환경 모두 충분히 긴 임의의 값을 환경변수로 주입하세요.
guardian.verification.hmac-secret=${GUARDIAN_VERIFICATION_HMAC_SECRET}

# 데모에서만 true로 설정하면, 인증된 송금 소유자가 demo-inbox API로 인증번호를 확인할 수 있습니다.
# 운영 환경에서는 반드시 false(기본값)로 유지하세요.
demo.guardian-inbox.enabled=${DEMO_GUARDIAN_INBOX_ENABLED:false}

# Azure Speech 설정입니다. 로컬에서는 아래 속성에 직접 값을 넣어도 됩니다.
# 환경변수를 사용할 경우 ${AZURE_SPEECH_*:} 형태로 바꿔도 동일하게 동작합니다.
azure.speech.key=your_azure_speech_key
azure.speech.endpoint=https://your-resource-name.cognitiveservices.azure.com
azure.speech.region=koreacentral
azure.speech.token-ttl-seconds=540
azure.speech.recognition-language=ko-KR
